// Dependency topology strategy for omp.nvim
//
// Target architecture (strict unidirectional):
//
//   Layer 0  Entry              parse / bind / handler shells / keymap
//                                 → allowed: Dispatch, Capabilities
//                                 × forbidden: Infrastructure
//
//   Layer 1  Dispatch            command registry / execute gate / hooks
//                                 → allowed: Capabilities, Infrastructure
//                                 × forbidden: Entry
//
//   Layer 2  Capabilities        CLI mirrors + Nvim-native + UI rendering
//                                 → allowed: Infrastructure, same-layer
//                                 × forbidden: Entry, Dispatch
//
//   Layer 3  Infrastructure      api_client / rpc process / event_manager
//                                 → allowed: same-layer, external
//                                 × forbidden: Entry, Dispatch, Capabilities
//
//   Foundation (layer-exempt)    config / state / util / promise / log / types
//                                 No rules — any layer may depend on these.
//
// NOTE: Module matching uses Python fnmatch — "omp.ui.*" matches
//       ALL depths (e.g. omp.ui.renderer.flush). First match wins
//       across groups, so put specific patterns before wildcards.
//
// STATUS: Draft. Needs owner review. Some placements are debatable — see
//         inline "REVIEW:" comments.
{
  "groups": {

    // ── Layer 0: Entry ──────────────────────────────────────────────
    // User-facing entry points. These modules receive user intent
    // (keypress, command, picker selection) and forward it to Dispatch.
    "entry_layer": {
      "modules": [
        "omp",                        // plugin setup entry
        "omp.api",                    // programmatic entry — wraps every action into dispatch_action()
        "omp.keymap",                 // keybinding → api calls
        "omp.quick_chat",             // standalone quick-chat entry
        "omp.quick_chat.*",

        // Handler shells — thin wrappers that define what each command does.
        // They call into Capabilities / Dispatch, never Infrastructure directly.
        "omp.commands.handlers.*",

        // UI modules that act as entry points: after user interaction,
        // they call api.lua (dispatch_action) to trigger commands.
        "omp.ui.session_picker",      // user picks session → api.select_session
        "omp.ui.permission_window",   // user grants/denies → api.permission_grant/deny
        "omp.ui.question_window",     // user answers question → handler callback
        "omp.ui.contextual_actions",  // user picks action → api.*
        "omp.ui.autocmds",            // nvim events → api calls
        "omp.ui.debug_helper"         // debug → session inspection
      ]
    },

    // ── Layer 1: Dispatch ───────────────────────────────────────────
    // Command registry, parsing, and execution gate.
    // Receives structured intent from Entry, routes to handler functions.
    "dispatch_layer": {
      "modules": [
        "omp.commands",               // command registry + execute_parsed_intent
        "omp.commands.dispatch",      // dispatch.execute — the unified gate
        "omp.commands.parse",         // argument parsing
        "omp.commands.slash",         // slash command mapping table
        "omp.commands.complete"       // command completion provider
      ]
    },

    // ── Layer 2: Capabilities ───────────────────────────────────────
    // Business logic, data access, rendering. Three sub-categories:
    //
    //   CLI mirrors    — query/mutate CLI server state via api_client
    //   Nvim-native    — editor-side capabilities (context, LSP, git)
    //   UI rendering   — window management, rendering pipeline, display
    //
    "capabilities_layer": {
      "modules": [
        // CLI mirrors
        "omp.session",                // session data query (calls state.api_client)
        "omp.config_file",            // remote config fetch via api_client
        //                                    REVIEW: could be Foundation (passive data source,
        //                                    in-degree 14), but it calls state.api_client
        //                                    which is an active Infrastructure dependency.

        // Nvim-native capabilities
        "omp.context",                // editor context collection
        "omp.context.*",
        "omp.history",                // prompt history
        "omp.model_picker",           // model selection UI
        "omp.variant_picker",         // variant selection UI
        "omp.image_handler",          // clipboard image handling
        "omp.git_review",             // git diff review
        "omp.lsp.*",                  // LSP completion service
        "omp.services.*",             // session/model/messaging orchestration


        // UI rendering & display
        "omp.ui.ui",                  // window container management
        //                                    REVIEW: currently violates no_capabilities_to_entry
        //                                    (→ api, autocmds, contextual_actions, session_picker).
        //                                    These deps should eventually be removed.
        "omp.ui.input_window",        // input buffer management
        "omp.ui.output_window",       // output buffer management
        "omp.ui.output",              // output composition
        "omp.ui.renderer",            // render pipeline
        "omp.ui.renderer.*",
        "omp.ui.render_state",        // render state tracking
        "omp.ui.formatter",           // message formatting
        "omp.ui.formatter.*",
        "omp.ui.footer",              // status bar
        "omp.ui.topbar",              // top bar
        "omp.ui.winbar",              // window bar
        "omp.ui.navigation",          // cursor navigation
        "omp.ui.diff_tab",            // diff view
        "omp.ui.dialog",              // dialog windows
        "omp.ui.completion",          // completion engine
        "omp.ui.completion.*",
        "omp.ui.context_bar",         // context display bar
        "omp.ui.reference_picker",    // reference browser
        "omp.ui.mention",             // @mention UI
        "omp.ui.file_picker",         // file browser
        "omp.ui.picker",              // generic picker
        "omp.ui.history_picker",      // history browser
        "omp.ui.permission.permission" // permission display
      ]
    },

    // ── Layer 3: CLI Infrastructure ─────────────────────────────────
    // Communication with the omp RPC process.
    // These modules should have ZERO upward dependencies.
    "cli_infrastructure_layer": {
      "modules": [
        "omp.api_client",             // RPC command facade and session process registry
        "omp.rpc_manager",            // workspace RPC lifecycle
        "omp.rpc.*",                  // stdio NDJSON transport and event adapter
        "omp.event_manager",          // adapted event stream consumer
        "omp.health"                  // :checkhealth RPC probe
      ]
    },

    // ── Foundation (no layer restrictions) ──────────────────────────
    // Passive modules: widely required, but never call upward.
    // Any layer may depend on these without triggering violations.
    "foundation": {
      "modules": [
        "omp.config",                 // configuration container (in-degree 57)
        "omp.state",                  // reactive store (in-degree 52)
        "omp.state.*",                // state sub-modules
        "omp.util",                   // utility functions (in-degree 30)
        "omp.promise",                // async primitive (in-degree 28)
        "omp.log",                    // logging
        "omp.types",                  // type definitions (zero runtime code)
        "omp.id",                     // ID generation
        "omp.throttling_emitter",     // batching primitive
        "omp.model_state",            // local model state file I/O

        // UI primitives — pure data or framework, no business logic
        "omp.ui.icons",               // icon data map (in-degree 26)
        "omp.ui.highlight",           // highlight group definitions
        "omp.ui.window_options",      // window config constants
        "omp.ui.loading_animation",   // animation frame data
        "omp.ui.timer",               // timer wrapper
        "omp.ui.buf_fix_win",         // buffer utility
        "omp.ui.prompt_guard_indicator", // display-only component
        "omp.ui.base_picker"          // picker framework (no business logic)
      ]
    }
  },

  "policy": {
    // Each rule forbids edges from one layer to another.
    // Foundation is exempt — never appears as from/to in rules.
    "rules": [
      {
        "name": "no_entry_to_infra",
        "from": "entry_layer",
        "to": ["cli_infrastructure_layer"]
        // Entry should go through Dispatch/Capabilities, not call infra directly.
        // Plugin setup currently initializes api_client/event_manager directly.
      },
      {
        "name": "no_dispatch_to_entry",
        "from": "dispatch_layer",
        "to": ["entry_layer"]
        // Dispatch must not call back into Entry. Currently clean (0 violations).
      },
      {
        "name": "no_capabilities_to_entry",
        "from": "capabilities_layer",
        "to": ["entry_layer"]
        // Capabilities must not drive Entry UI or call api.lua.
        // Renderer/UI dependencies remain inherited cleanup targets.
      },
      {
        "name": "no_capabilities_to_dispatch",
        "from": "capabilities_layer",
        "to": ["dispatch_layer"]
        // Current violations (2): completion.commands→commands.slash, input_window→commands.slash
        // These need slash command list for completion — may need a data-only export.
      },
      {
        "name": "no_infra_to_entry",
        "from": "cli_infrastructure_layer",
        "to": ["entry_layer"]
        // Currently clean (0 violations).
      },
      {
        "name": "no_infra_to_dispatch",
        "from": "cli_infrastructure_layer",
        "to": ["dispatch_layer"]
        // Currently clean (0 violations).
      },
      {
        "name": "no_infra_to_capabilities",
        "from": "cli_infrastructure_layer",
        "to": ["capabilities_layer"]
        // Currently clean (0 violations).
      }
    ]
  }
}
